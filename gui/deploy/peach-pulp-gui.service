# PEACH PULP operator GUI — systemd user/system service for the Pi.
# Install:  sudo cp deploy/peach-pulp-gui.service /etc/systemd/system/
#           sudo systemctl enable --now peach-pulp-gui
# Assumes the repo is at /home/pi/PEACH-PULP and a venv at gui/.venv (see install.sh).

[Unit]
Description=PEACH PULP operator GUI
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/PEACH-PULP/gui
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/pi/PEACH-PULP/gui/.venv/bin/python run.py --fullscreen
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
